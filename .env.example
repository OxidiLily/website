# ── Supabase (self-hosted) ───────────────────────────────────────────────
# Vite hanya mengekspos variabel berawalan VITE_ ke bundel browser.
# Nama NEXT_PUBLIC_* milik Next.js dan TIDAK terbaca di project ini.
# Kedua nilai di bawah memang ikut terkirim ke browser — itu perancangannya;
# yang menjaga data adalah Row Level Security di supabase/schema.sql.
VITE_SUPABASE_URL="http://192.168.2.99:8000"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# GEMINI_API_KEY: dipakai AI Studio, tidak dirujuk kode di src/.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Origin gateway AI (9router/OpenAI/DeepSeek). Origin PERTAMA jadi target
# proxy `/ai/*`; semuanya masuk connect-src di Content-Security-Policy.
# Isi Base URL di Pengaturan → AI Agent dengan jalur proxy-nya:
#   /ai/v1
# Bukan URL langsung ke gateway — 9router tidak menjawab preflight CORS di /v1,
# jadi panggilan lintas-origin dari browser selalu diblokir.
# VITE_AI_ORIGIN="http://ai.home:20128"
VITE_AI_ORIGIN=""

# Kunci gateway AI untuk asisten di halaman PUBLIK. TANPA awalan VITE_ dengan
# sengaja: hanya variabel berawalan itu yang masuk ke bundel, jadi kunci ini
# tetap di sisi server dan tidak pernah terbaca pengunjung. Server penyaji
# menyuntikkannya ke setiap permintaan `/ai/*` yang belum membawa auth sendiri.
# Kosongkan kalau asisten publik tidak boleh memanggil model — asisten tetap
# jalan, hanya memakai jawaban cadangan dari panel.
AI_API_KEY=""
