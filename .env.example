# Berkas contoh. Salin ke `.env` (diabaikan git) lalu isi nilainya.
# Berkas yang SAMA dibaca `npm run dev`, `npm run build`, unit systemd di
# host, dan docker-compose.yml — tidak ada nilai yang ditulis dua kali.

# ── Supabase ─────────────────────────────────────────────────────────────
# Wajib. Vite hanya mengekspos variabel berawalan VITE_ ke bundel browser;
# nama NEXT_PUBLIC_* milik Next.js dan TIDAK terbaca di project ini.
#
# Alamat ini dibaca SERVER, bukan browser: vite.config.ts memproksikan
# `/supabase/*` ke sini, dan src/lib/apiBase.ts membuat browser memanggil
# origin situs sendiri. Jadi isi alamat yang terjangkau MESIN PENYAJI — alamat
# LAN sudah cukup, dan pengunjung dari tailnet tetap mendapat seluruh data.
VITE_SUPABASE_URL="http://supabase.home:8000"

# Kunci publishable/anon Supabase. Ikut terpanggang ke bundel browser — itu
# perancangannya; yang menjaga data adalah Row Level Security di
# supabase/schema.sql, bukan kerahasiaan kunci ini.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── Gateway AI (9router / OpenAI-compatible) ─────────────────────────────
# Origin yang boleh dihubungi panel admin, dipisah koma. Origin PERTAMA jadi
# target proxy `/ai/*`; semuanya masuk connect-src di Content-Security-Policy.
# Kosong → panel hanya bisa memakai endpoint yang se-origin dengan situs.
#
# Isi Base URL di Pengaturan → AI Agent dengan jalur proxy-nya (`/ai/v1`),
# BUKAN URL langsung ke gateway: 9router tidak menjawab preflight CORS di
# /v1, jadi panggilan lintas-origin dari browser selalu diblokir.
VITE_AI_ORIGIN=""

# Kunci gateway AI untuk asisten di halaman PUBLIK. Sengaja TANPA awalan
# VITE_: hanya variabel berawalan itu yang masuk ke bundel, jadi kunci ini
# tetap di sisi server. Server penyaji menyuntikkannya ke setiap permintaan
# `/ai/*` yang belum membawa auth sendiri.
# Kosongkan kalau asisten publik tidak boleh memanggil model — asisten tetap
# jalan, hanya memakai jawaban cadangan dari panel.
AI_API_KEY=""

# Bentuk yang dipakai container: vite.config.ts membaca nilainya dari BERKAS.
# docker-compose.yml sudah mengarahkannya ke /run/secrets/ai_api_key, dan
# secret itu bersumber dari AI_API_KEY di atas. Hanya perlu diisi manual
# kalau berkasnya dipasang di luar Compose.
# AI_API_KEY_FILE="/run/secrets/ai_api_key"

# ── Batas pemakaian kunci AI publik ──────────────────────────────────────
# Kunci di atas dipakai asisten di halaman PUBLIK, dan situs ini bisa dijangkau
# siapa pun yang ada di jaringan yang sama. Tanpa batas, satu perintah curl
# tanpa login cukup untuk menghabiskan kuotanya. Nilai di bawah ini yang
# membatasinya; semuanya berlaku HANYA untuk permintaan tanpa auth — panel
# admin memakai kunci dari tabel `settings`, tidak dipotong dan tidak dibatasi
# per pemanggil.
#
# Nilai bawaan (dipakai kalau barisnya dikosongkan) sengaja ditulis di sini
# supaya bisa dibandingkan sebelum diubah.
# AI_RATE_LIMIT="30/60"          # permintaan per pemanggil per jendela
# AI_RATE_LIMIT_GLOBAL="300/60"  # jendela menyeluruh, berlaku untuk semua
# AI_MAX_TOKENS="2048"           # batas atas max_tokens permintaan publik
# AI_MAX_BODY_BYTES="131072"     # 128 KB
# AI_MAX_MESSAGE_CHARS="24000"   # panjang seluruh pesan yang dikirim
# AI_MAX_RESPONSE_BYTES="4194304"# jawaban gateway yang mau dibaca
# AI_TIMEOUT_MS="240000"
#
# Isi `1` HANYA kalau container web berada di belakang reverse proxy (openresty)
# dan TIDAK bisa dihubungi langsung. Dengan `1`, batas laju memakai alamat di
# `X-Forwarded-For`; tanpa proxy di depan, header itu ditulis klien sendiri —
# mempercayainya berarti setiap penyerang mendapat jatahnya sendiri hanya dengan
# mengarang header. Karena docker-compose.yml juga memublikasikan port 3000 ke
# LAN, bawaannya adalah TIDAK mempercayainya.
# AI_TRUST_PROXY="1"

# ── SEO ──────────────────────────────────────────────────────────────────
# Dipakai scripts/seo-files.ts untuk canonical dan sitemap, dan dipanggang
# sebagai ARG di Dockerfile. Kosong → jatuh ke setting `site_website` di
# Supabase; kalau keduanya kosong, tahap sitemap dilewati dan build tetap
# berhasil.
SITE_URL=""

# ── Inisialisasi akun admin ──────────────────────────────────────────────
# Hanya dibaca layanan sekali jalan `admin-init` saat `docker compose up`.
# Service role BYPASS RLS: jangan pernah memberi awalan VITE_ (bocor ke
# browser) dan jangan menyimpannya di berkas yang ikut build.
# Kata sandi di sini adalah kata sandi AWAL — login pertama wajib
# menggantinya sebelum hak admin terbuka (supabase/require-password-change.sql).
SUPABASE_SERVICE_ROLE_KEY=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Uji panel di browser (scripts/admin.mjs) membaca nama yang berbeda:
# ADMIN_EMAIL (sama) dan ADMIN_PASS. Isi juga kalau skrip itu dipakai.
# ADMIN_PASS=""

# ── Opsional ─────────────────────────────────────────────────────────────
# Port host untuk container web. Default 3000 — samakan hanya kalau port itu
# sudah dipakai unit systemd `desain-web.service`.
# WEB_PORT=3000

# Hanya terbaca dari environment shell, BUKAN dari berkas ini: mematikan HMR
# vite (dipakai saat menyunting banyak berkas agar layar tidak berkedip).
# DISABLE_HMR=true
